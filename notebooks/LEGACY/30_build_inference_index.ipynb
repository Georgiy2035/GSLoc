   "source": [
    "selected_indices = filtered_df.index.tolist()\n",
    "print(f\"selected {len(selected_indices)} indices, first 5: {selected_indices[:5]}\")\n"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "f34ac060",
   "metadata": {},
   "source": [
    "## get paths for point clouds files"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "54511615",
   "metadata": {},
   "outputs": [],
   "source": [
    "scans = sorted((DB_MAP_DIR / \"scans\").glob(\"*.pcd\"))\n",
    "print(f\"Found {len(scans)} scans\")\n",
    "\n",
    "selected_scans = [scans[i] for i in selected_indices]\n",
    "print(f\"selected {len(selected_scans)} scans, first 5: {selected_scans[:5]}\")\n",
    "\n",
    "selected_scans_paths = [str(scan.relative_to(DB_MAP_DIR)) for scan in selected_scans]\n",
    "print(f\"selected_scans_paths: {selected_scans_paths}\")"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "53846328",
   "metadata": {},
   "source": [
    "## calculate descriptors for index"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "e52757e1",
   "metadata": {},
   "outputs": [],
   "source": [
    "from opr.models.place_recognition import MinkLoc3D\n",
    "\n",
    "model = MinkLoc3D()"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "a3c205ac",
   "metadata": {},
   "outputs": [],
   "source": [
    "!wget -q -O ../minkloc3d_nclt.pth \\\n",
    "    https://huggingface.co/OPR-Project/PlaceRecognition-NCLT/resolve/main/minkloc3d_nclt.pth"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "2bd91cc6",
   "metadata": {},
   "outputs": [],
   "source": [
    "model.load_state_dict(torch.load(\"../minkloc3d_nclt.pth\"), strict=True)\n",
    "model.eval()\n",
    "\n",
    "device = torch.device(\"cuda\" if torch.cuda.is_available() else \"cpu\")\n",
    "model.to(device);"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "e38bc859",
   "metadata": {},
   "outputs": [],
   "source": [
    "def read_scan(scan_filepath: str | Path) -> tuple[np.ndarray, np.ndarray]:\n",
    "    \"\"\"Read a point cloud scan from a file.\n",
    "    Args:\n",
    "        scan_filepath (str | Path): Path to the point cloud file.\n",
    "    Returns:\n",
    "        tuple: A tuple containing:\n",
    "            - coordinates (np.ndarray): The coordinates of the point cloud as an Nx3 array.\n",
    "            - features (np.ndarray): The features of the point cloud as an Nx1 array (intensity or ones).\n",
    "    Raises:\n",
    "        ValueError: If the scan file is empty or has an unexpected format.\n",
    "    \"\"\"\n",
    "    scan = o3d.io.read_point_cloud(str(scan_filepath))\n",
    "    if not scan.has_points():\n",
    "        raise ValueError(f\"Scan file {scan_filepath} is empty or invalid.\")\n",
    "    # Convert to numpy array for easier manipulation\n",
    "    scan = np.asarray(scan.points)\n",
    "    coordinates = scan[:, :3]  # Get the first three columns (x, y, z)\n",
    "    if scan.shape[1] == 3:\n",
    "        features = np.ones((coordinates.shape[0], 1))\n",
    "    elif scan.shape[1] == 4:\n",
    "        features = scan[:, 3:4]  # Get the fourth column (intensity)\n",
    "    else:\n",
    "        raise ValueError(f\"Unexpected scan format with shape {scan.shape}. Expected 3 or 4 columns.\")\n",
    "    return coordinates, features\n",
    "\n",
    "def to_batch(coords: np.ndarray, feats: np.ndarray) -> dict[str, Tensor]:\n",
    "    \n",
    "    coords_t = torch.from_numpy(coords).float()\n",
    "    feats_t = torch.from_numpy(feats).float()\n",
    "    quantized_coords, quantized_feats = ME.utils.sparse_quantize(\n",
    "        coordinates=coords_t,\n",
    "        features=feats_t,\n",
    "        quantization_size=POINTCLOUD_QUANTIZATION_SIZE,\n",
    "    )\n",
    "    return {\n",
    "        \"pointclouds_lidar_coords\": ME.utils.batched_coordinates([quantized_coords]),\n",
    "        \"pointclouds_lidar_feats\": torch.cat([quantized_feats])\n",
    "    }"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "5a8b7e61",
   "metadata": {},
   "outputs": [],
   "source": [
    "descriptors = []\n",
    "for scan_path in selected_scans_paths:\n",
    "    coords, feats = read_scan(DB_MAP_DIR / scan_path)\n",
    "    batch = to_batch(coords, feats)\n",
    "    batch = {k: v.to(device) for k, v in batch.items()}\n",
    "    with torch.no_grad():\n",
    "        desc = model(batch)\n",
    "    descriptors.append(desc[\"final_descriptor\"].cpu().numpy())\n",
    "descriptors = np.concatenate(descriptors, axis=0)\n",
    "np.save(DB_MAP_DIR / \"descriptors.npy\", descriptors)\n",
    "\n",
    "print(f\"Descriptors saved to {DB_MAP_DIR / 'descriptors.npy'}\")\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "269fd42e",
   "metadata": {},
   "outputs": [],
   "source": [
    "N, D = descriptors.shape\n",
    "print(f\"descriptors shape: {descriptors.shape}\")"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "aa57a2ce",
   "metadata": {},
   "source": [
    "## build FaissFlatIndex files"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "cca168f0",
   "metadata": {},
   "outputs": [],
   "source": [
    "# Build minimal FAISS index files for the filtered database and load FaissFlatIndex\n",
    "import json\n",
    "from opr.inference.index import FaissFlatIndex\n",
    "\n",
    "index_dir = DB_MAP_DIR\n",
    "\n",
    "# Build meta.parquet with required columns; pointcloud_path omitted (treated as NaN)\n",
    "poses = filtered_df[[\"x\", \"y\", \"z\", \"qx\", \"qy\", \"qz\", \"qw\"]].to_numpy(dtype=float)\n",
    "poses_list = [list(p) for p in poses]\n",
    "meta = pd.DataFrame({\n",
    "    \"idx\": filtered_df.index.to_numpy(dtype=np.int64),\n",
    "    \"pose\": poses_list,\n",
    "    \"pointcloud_path\": selected_scans_paths,\n",
    "})\n",
    "meta.to_parquet(index_dir / \"meta.parquet\")\n",
    "\n",
    "# Minimal schema.json\n",
    "schema = {\"version\": \"1\", \"dim\": D, \"metric\": \"l2\", \"created_at\": \"\", \"opr_version\": \"\"}\n",
    "(index_dir / \"schema.json\").write_text(json.dumps(schema))\n",
    "\n",
    "# Load the index\n",
    "index = FaissFlatIndex.load(index_dir)\n",
    "print(f\"Index created at {index_dir}\")\n",
    "print(f\"Index size: {index.size()}, dim: {index.dim()} metric: {index.metric()}\")\n"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "c018b48c",
   "metadata": {},
   "source": [
    "# Sample PlaceRecognitionPipeline inference"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "99e15331",
   "metadata": {},
   "outputs": [],
   "source": [
    "QUERY_MAP_DIR = root_data_dir / \"map2\" / \"keyframe_map\"\n",
    "assert QUERY_MAP_DIR.exists(), f\"Path {QUERY_MAP_DIR} does not exist\"\n",
    "\n",
    "sample_query_coords, sample_query_feats = read_scan(QUERY_MAP_DIR / \"scans\" / \"000036.pcd\")\n",
    "sample_query_batch = to_batch(sample_query_coords, sample_query_feats)\n",
    "sample_query_batch = {k: v.to(device) for k, v in sample_query_batch.items()}\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "d44b58cd",
   "metadata": {},
   "outputs": [],
   "source": [
    "# Load index and run PlaceRecognitionPipeline\n",
    "from opr.inference.index import FaissFlatIndex\n",
    "from opr.inference.pipelines import PlaceRecognitionPipeline, SequencePlaceRecognitionPipeline\n",
    "\n",
    "index = FaissFlatIndex.load(DB_MAP_DIR)\n",
    "single_frame_pipeline = PlaceRecognitionPipeline(index=index, model=model, device=\"cuda\")\n",
    "pipeline = SequencePlaceRecognitionPipeline(index=index, model=model, device=\"cuda\", max_window=22)\n",
    "\n",
    "result = pipeline.infer(input_frame=sample_query_batch, k=5)\n",
    "print(f\"descriptor shape: {result.descriptor.shape}\")\n",
    "print(f\"indices: {result.indices.tolist()}\")\n",
    "print(f\"distances: {[float(x) for x in result.distances]}\")\n",
    "print(f\"db_idx: {result.db_idx.tolist()}\")\n",
    "print(f\"db_pose (first): {result.db_pose[0]}\")"
   ]
  },
