    ")\n",
    "assert root_data_dir.exists(), f\"Path {root_data_dir} does not exist\"\n",
    "\n",
    "DB_MAP_DIR = root_data_dir / \"map1\" / \"keyframe_map\"\n",
    "assert DB_MAP_DIR.exists(), f\"Path {DB_MAP_DIR} does not exist\"\n"
   ]
