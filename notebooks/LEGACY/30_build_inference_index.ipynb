    "    dist_thresh=DIST_THRESH,\n",
    "    angle_thresh_deg=ANGLE_THRESH_DEG,\n",
    ")\n",
    "print(filtered_df.head())\n",
    "print(filtered_df.tail())"
   ]
  },
  {
